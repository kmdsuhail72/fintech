# Copy to .env.docker.dev. This file is for local Docker development only.
POSTGRES_DB=asteriq
POSTGRES_USER=asteriq
POSTGRES_PASSWORD=asteriq_local_only
JWT_ACCESS_SECRET=local-docker-secret-change-before-production-32chars
WEB_BIND=127.0.0.1
WEB_PORT=8080
API_PORT=3000
AI_SERVICE_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081
AUTH_WEB_URL=http://localhost:8080
SMTP_URL=
AUTH_EMAIL_FROM=
DEV_AUTH_TOKEN_OUTPUT=true
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
RESEARCH_ASSISTANT_ENABLED=true
INSTALL_NEWS_NLP=false
NEWS_SENTIMENT_LOCAL_FILES_ONLY=true
ALERT_WORKERS_ENABLED=true
EXPO_ACCESS_TOKEN=
RUN_MIGRATIONS=true
DEV_POLLING=true
