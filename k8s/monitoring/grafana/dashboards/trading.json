{
  "id": null,
  "uid": "asteriq-trading",
  "title": "Asteriq AI / Trading",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["asteriq", "prometheus", "trading"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "namespace",
        "label": "Environment namespace",
        "type": "custom",
        "query": "asteriq-dev,asteriq-staging,asteriq-production",
        "multi": true,
        "includeAll": true,
        "allValue": "asteriq-(dev|staging|production)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Asteriq dashboards",
      "type": "dashboards",
      "tags": ["asteriq"],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "title": "Orders per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace)(rate(asteriq_trading_requests_total{namespace=~\"$namespace\"}[$__rate_interval])) * 60",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Successful order responses per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Includes successful idempotent replay responses; not a unique order count.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace)(rate(asteriq_http_requests_total{namespace=~\"$namespace\",operation=\"trading\",method=\"POST\",status=~\"2..\"}[$__rate_interval])) * 60",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Failed order requests per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Includes authentication/validation failures and aborted requests.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace)(rate(asteriq_failed_orders_total{namespace=~\"$namespace\"}[$__rate_interval])) * 60",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
