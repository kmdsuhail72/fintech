    {
      "title": "LLM failure ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace)(rate(llm_failures_total{namespace=~\"$namespace\"}[$__rate_interval])) / clamp_min(sum by(namespace)(rate(llm_calls_total{namespace=~\"$namespace\"}[$__rate_interval])),0.001)",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
