{
  "name": "@asteriq/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @asteriq/types && npm run build --workspace @asteriq/utils && npm run build --workspace @asteriq/ui",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --tsconfig tsconfig.json --import ./tests/setup-react.mjs --test tests/*.test.tsx"
  },
  "dependencies": {
    "@asteriq/types": "*",
    "@asteriq/ui": "*",
    "@asteriq/utils": "*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@tanstack/react-query": "^5.104.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "vite": "^6.2.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.15",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.19.3"
  }
}
