APP_ENV=development
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO

# Optional, trusted local artifact and digest printed by offline training.
ML_MODEL_PATH=
ML_MODEL_SHA256=

# Local financial NLP; warm model cache with scripts/warm_news_model.py --download.
NEWS_SENTIMENT_ENABLED=true
NEWS_SENTIMENT_MODEL=ProsusAI/finbert
NEWS_SENTIMENT_REVISION=4556d13015211d73dccd3fdd39d39232506f3e43
NEWS_SENTIMENT_CACHE_DIR=artifacts/huggingface
NEWS_SENTIMENT_LOCAL_FILES_ONLY=true
NEWS_SENTIMENT_BATCH_SIZE=8

# Research assistant: server-only secret, never EXPO_PUBLIC/VITE configuration.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
RESEARCH_ASSISTANT_ENABLED=true
RESEARCH_BACKEND_URL=http://127.0.0.1:3000/api/v1
RAG_DATABASE_URL=postgresql://asteriq:asteriq_local_only@127.0.0.1:5432/asteriq
