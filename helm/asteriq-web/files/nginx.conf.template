worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 2048; }
http {
include /etc/nginx/mime.types;
log_format asteriq_json escape=json '{"timestamp":"$time_iso8601","level":"info","service":"web","environment":null,"namespace":null,"pod":null,"request_id":"$request_id","trace_id":"$upstream_http_x_trace_id","user_safe_identifier":null,"endpoint":"$asteriq_endpoint","status_code":$status,"event":"http_request","method":"$request_method","durationSeconds":$request_time,"upstreamSeconds":"$upstream_response_time"}';
map $uri $asteriq_endpoint {
  ~^/api/ "/api/*";
  ~^/socket.io/ "/socket.io/*";
  /health "/health";
  default "web";
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}
server {
  access_log /dev/stdout asteriq_json;
  listen __ASTERIQ_LISTEN_PORT__;
  server_name _;
  root /usr/share/nginx/html;
  client_body_temp_path /tmp/client;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  index index.html;
  client_max_body_size 10m;
  resolver __ASTERIQ_DNS_RESOLVER__ valid=10s ipv6=off;
  set $api_upstream __ASTERIQ_API_UPSTREAM__;

  location /api/ {
    proxy_pass $api_upstream$request_uri;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_connect_timeout 5s;
    proxy_read_timeout 190s;
    proxy_send_timeout 190s;
  }
  location /socket.io/ {
    proxy_pass $api_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 90s;
  }
  location /health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }
  location / { try_files $uri $uri/ /index.html; }
}

}
