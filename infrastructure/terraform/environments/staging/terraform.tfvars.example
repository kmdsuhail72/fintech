environment = "staging"
region = "ap-south-1"
account_id = "REPLACE_ACCOUNT_ID"
vpc_cidr = "10.21.0.0/16"
azs = ["ap-south-1a", "ap-south-1b"]
zone_id = "REPLACE_EXISTING_ROUTE53_ZONE_ID"
domain_name = "staging.example.com"
auth_email_from = "notifications@example.com"
nat_per_az = true
desired_count = 2
db_multi_az = true
db_instance_class = "db.t4g.small"
redis_node_type = "cache.t4g.small"
redis_replicas = 1
log_retention_days = 30
redis_auth_token_version = 1
# Replace with actual scanned image digests; do not use these example values.
images = {
  web = "REPLACE_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/asteriq-staging/web@sha256:REPLACE_DIGEST"
  api = "REPLACE_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/asteriq-staging/api@sha256:REPLACE_DIGEST"
  ai-service = "REPLACE_ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/asteriq-staging/ai-service@sha256:REPLACE_DIGEST"
}
