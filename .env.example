NODE_ENV=development
API_PORT=3000
TRUST_PROXY_HOPS=1
MARKET_SIMULATION_INTERVAL_MS=3000
MARKET_HISTORY_INTERVAL_MS=15000
DATABASE_URL=postgresql://asteriq:asteriq_local_only@localhost:5432/asteriq
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
VITE_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
AI_SERVICE_URL=http://localhost:8000
APP_ENV=development
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO
JWT_ACCESS_SECRET=replace-this-local-only-secret-with-at-least-32-random-characters
JWT_ISSUER=asteriq-ai
JWT_AUDIENCE=asteriq-clients
AUTH_WEB_URL=http://localhost:5173
DEFAULT_CURRENCY=USD
INITIAL_VIRTUAL_CAPITAL=100000
SMTP_URL=
AUTH_EMAIL_FROM=
DEV_AUTH_TOKEN_OUTPUT=true

# Internal AI service; OpenAI credentials belong only to the Python service.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
RESEARCH_ASSISTANT_ENABLED=true
RESEARCH_BACKEND_URL=http://127.0.0.1:3000/api/v1
RAG_DATABASE_URL=postgresql://asteriq:asteriq_local_only@127.0.0.1:5432/asteriq

# Run workers in the API locally; set false and start worker:alerts to scale separately.
ALERT_WORKERS_ENABLED=true
EXPO_ACCESS_TOKEN=
