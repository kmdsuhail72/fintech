# Copy to .env.docker.prod and replace empty required values.
# Use distinct randomly generated hex credentials (URL-safe); never commit the populated file.
POSTGRES_DB=asteriq
POSTGRES_USER=asteriq
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
DATABASE_URL=postgresql://asteriq:${POSTGRES_PASSWORD}@postgres:5432/asteriq
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
SITE_URL=https://asteriq.example.com
WEB_BIND=127.0.0.1
WEB_PORT=8080
SMTP_URL=
AUTH_EMAIL_FROM=
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
RESEARCH_ASSISTANT_ENABLED=true
INSTALL_NEWS_NLP=false
NEWS_SENTIMENT_LOCAL_FILES_ONLY=true
ALERT_WORKERS_ENABLED=true
EXPO_ACCESS_TOKEN=
RUN_MIGRATIONS=true
LOG_LEVEL=INFO
